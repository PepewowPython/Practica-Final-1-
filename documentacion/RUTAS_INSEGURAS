porción, * 100 lo convierte a %\n","kpi1 = (\n","    df['¿Cuál considera que debe ser la principal prioridad de la aplicación?\\nSeguridad del usuario'].str.contains('Seguridad', case=False, na=False).mean()\n","    * 100\n",")\n","\n","# KPI 2: % de usuarios que exigen Alertas Críticas (Zonas Peligrosas o Robos)\n","kpi2 = (\n","    df['¿Qué tipo de alertas considera más importantes?']\n","    .str.contains('Zonas peligrosas|Robos reportados', case=False, na=False)\n","    .mean()\n","    * 100\n",")\n","\n","print(f\"KPI 1 - Prioridad en Seguridad del Usuario: {kpi1:.1f}%\")\n","print(f\"KPI 2 - Necesidad de Alertas Críticas (Zonas/Robos): {kpi2:.1f}%\")\n","\n","# Diccionario de conversión: Mapea respuestas cualitativas a una escala numérica\n","mapa_prioridad = {\n","    'Seguridad del usuario': 3.0,\n","    'Rapidez de la ruta': 2.0,\n","    'Información del tráfico': 1.0,\n","}\n","\n","# Aplicar la conversión usando .map()\n","df['Prioridad_Num'] = df['¿Cuál considera que debe ser la principal prioridad de la aplicación?\\nSeguridad del usuario'].map(mapa_prioridad)\n","\n","# Calcular estadísticas cuantitativas (Promedio y Mediana)\n","print(\n","    'Promedio de Prioridad de Seguridad (1: Tráfico, 2: Rapidez, 3:'\n","    f\" Seguridad): {df['Prioridad_Num'].mean():.2f}\"\n",")\n","print(f\"Mediana: {df['Prioridad_Num'].median():.2f}\")\n","\n","# Función para obtener la moda de forma segura\n","# La \"moda\" es el valor que más se repite en una serie\n","def moda_segura(x):\n","  m = x.mode()\n","  return m.iloc[0] if not m.empty else 'Sin datos'\n","\n","\n","# Agrupar por la Prioridad de la App y encontrar el tipo de alerta más votado (moda)\n","alerta_por_prioridad = df.groupby('¿Cuál considera que debe ser la principal prioridad de la aplicación?\\nSeguridad del usuario')['¿Qué tipo de alertas considera más importantes?'].agg(\n","    moda_segura\n",")\n","\n","print(\"Tipo de alerta más solicitado según la Prioridad del usuario:\")\n","print(alerta_por